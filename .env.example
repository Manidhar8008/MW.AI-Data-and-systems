# Root environment reference for local development.
# Copy values into backend/.env and frontend/.env as needed.

ENVIRONMENT=local
LOG_LEVEL=INFO

# Backend
DATABASE_URL=postgresql+asyncpg://mwai:mwai_password@localhost:5432/mwai_crm
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
BACKEND_CORS_ORIGINS=http://localhost:5173

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_DEFAULT_TENANT_ID=local-demo-tenant

