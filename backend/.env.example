# Backend local environment template.
# Copy this file to backend/.env for local development.

ENVIRONMENT=local
LOG_LEVEL=INFO
APP_NAME=MW.AI Data and Systems API
API_PREFIX=/api/v1

DATABASE_URL=postgresql+asyncpg://mwai:mwai_password@localhost:5432/mwai_crm
SQL_ECHO=false

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

BACKEND_CORS_ORIGINS=http://localhost:5173

